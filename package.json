{
  "name": "agentic-forms",
  "version": "0.7.0",
  "description": "Build forms and collect answers into tables.",
  "keywords": [
    "forms",
    "surveys",
    "responses",
    "agents",
    "mcp",
    "cli",
    "tables",
    "collaboration"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-forms.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-forms",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/embed.css"
  },
  "scripts": {
    "build": "tsup",
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "test": "npm run build:ui && vitest run",
    "test:ui": "npm run build && npm run build:ui && playwright test",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:ui",
    "deploy:demo": "npm run build:ui && WRANGLER_SEND_METRICS=false wrangler deploy -c wrangler.demo.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "agentic-design": "^0.3.3",
    "agentic-identity": "^0.7.0",
    "hono": "^4.13.14",
    "re2js": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "bin": {
    "agentic-forms": "./dist/cli.js"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
