{
  "name": "agentic-forms",
  "version": "0.0.0",
  "description": "Build forms and collect answers into tables.",
  "keywords": [
    "forms",
    "surveys",
    "responses",
    "agents",
    "mcp",
    "cli",
    "tables",
    "collaboration"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-forms.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-forms",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-identity": "^0.1.0",
    "hono": "^4.13.14",
    "re2js": "^2.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "jsdom": "^30.1.3",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "bin": {
    "agentic-forms": "./dist/cli.js"
  }
}
