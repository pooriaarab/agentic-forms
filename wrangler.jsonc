{
  "name": "agentic-forms",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  // Hard-delete responses past their retention date, every 10 minutes.
  "triggers": { "crons": ["7,17,27,37,47,57 * * * *"] },
  "vars": { "FORMS_REGION": "eu" },
  // Create the database in the EU, then paste its id below:
  //   wrangler d1 create agentic-forms --location weur
  "d1_databases": [{ "binding": "DB", "database_name": "agentic-forms", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
